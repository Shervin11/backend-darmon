# Copy to .env and fill in. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL (production). Without it an embedded PGlite database in ./data/pglite is used (development only).
# DATABASE_URL=postgres://darmon:darmon@localhost:5432/darmon
# PGLITE_DIR=./data/pglite

# Uploaded files (avatars, diplomas, voice messages) and the public base URL used in API responses
# UPLOAD_DIR=./uploads
# PUBLIC_URL=https://api.example.tj

# FRONTEND_URL=http://localhost:3000
# PORT=3001
# Clinic time zone used for schedules, reminders and "in the past" checks
# APP_UTC_OFFSET=+05:00

# AI diploma verification
GROQ_API_KEY=
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Telegram bot for notifications, reminders and password reset codes (create one with @BotFather)
TELEGRAM_BOT_TOKEN=

# SMS: unset = off, "console" = log only (development), "http" = POST {to, text, sender} to your gateway
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://sms-gateway.example.tj/send
# SMS_HTTP_TOKEN=
# SMS_SENDER=DARMON

# Backups (scripts/backup.sh)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
